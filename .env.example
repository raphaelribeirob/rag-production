# Copy to .env and adjust. Never commit .env.
# Local docker-compose default. For Neon: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# one of: extractive | ollama | hosted_free
LLM_PROVIDER=extractive
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
# Only needed when LLM_PROVIDER=hosted_free
HOSTED_LLM_API_KEY=
# REQUIRED for POST /ingest (fails closed if empty). Use a long random value; never commit it.
API_KEY=change-me-to-a-random-value
TOP_K=5
