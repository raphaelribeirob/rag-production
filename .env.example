# Copy to .env and adjust. Never commit .env.
# Local docker-compose default. For Neon: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# one of: extractive (no model) | mock (deterministic, CI) | ollama (local, optional)
#         | llamacpp (in-process GGUF via llama-cpp-python, optional, local only)
# hosted_free is reserved and raises NotImplementedError (no hosted accounts).
LLM_PROVIDER=extractive
# Ollama must be local: non-localhost URLs are rejected.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Path to a local GGUF file (first shard if split). Placeholder; only used with llamacpp.
LLAMACPP_MODEL_PATH=
# REQUIRED for POST /ingest (fails closed if empty). Use a long random value; never commit it.
API_KEY=change-me-to-a-random-value
TOP_K=5
# Retrieval (defaults = baseline): chunk size/overlap in chars; each non-default chunk config
# is ingested into its own table (e.g. chunks_c600_o100). RERANKER empty = off; when set,
# RERANK_CANDIDATES dense hits are reranked to TOP_K (revision pinned in config.py).
CHUNK_SIZE=1200
CHUNK_OVERLAP=0
RERANKER=
RERANK_CANDIDATES=20
# llamacpp sampling: 0 = greedy (baseline). >0 samples, seeded by LLM_SEED.
LLM_TEMPERATURE=0
LLM_SEED=0
